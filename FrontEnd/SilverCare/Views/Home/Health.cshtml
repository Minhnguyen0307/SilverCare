            <text x="155" y="210" text-anchor="middle" class="chart-axis-text">26/08</text>
            <text x="260" y="210" text-anchor="middle" class="chart-axis-text">27/08</text>
            <text x="365" y="210" text-anchor="middle" class="chart-axis-text">28/08</text>
            <text x="470" y="210" text-anchor="middle" class="chart-axis-text">29/08</text>
            <text x="575" y="210" text-anchor="middle" class="chart-axis-text">30/08</text>
            <text x="680" y="210" text-anchor="middle" class="chart-axis-text">31/08</text>

            <!-- Guide dashed line (vertical tracker) -->
            <line x1="0" y1="10" x2="0" y2="190" class="chart-hover-guideline" id="hover-guideline" />

            <!-- Dynamic Paths -->
            <path id="trend-path-sys" class="chart-line-sys" d="" />
            <path id="trend-path-dia" class="chart-line-dia" d="" />
            <path id="trend-path-hr" class="chart-line-hr" d="" />

            <!-- Dynamic Tracker dots -->
            <circle id="tracker-dot-sys" class="chart-tracker-dot sys" />
            <circle id="tracker-dot-dia" class="chart-tracker-dot dia" />
            <circle id="tracker-dot-hr" class="chart-tracker-dot hr" />
        </svg>

        <!-- Dynamic Tooltip -->
        <div class="chart-tooltip" id="chart-hover-tooltip">
            <h3 class="chart-tooltip-header" id="tooltip-day-header">28/08</h3>
            <div class="chart-tooltip-row">
                <span class="chart-tooltip-label">Huyết áp tâm thu:</span>
                <span class="chart-tooltip-value chart-tooltip-val-sys" id="tooltip-val-sys">135</span>
            </div>
            <div class="chart-tooltip-row">
                <span class="chart-tooltip-label">Huyết áp tâm trương:</span>
                <span class="chart-tooltip-value chart-tooltip-val-dia" id="tooltip-val-dia">88</span>
            </div>
            <div class="chart-tooltip-row">
                <span class="chart-tooltip-label">Nhịp tim:</span>
                <span class="chart-tooltip-value chart-tooltip-val-hr" id="tooltip-val-hr">73</span>
            </div>
        </div>
    </div>
    
    <!-- Legend -->
    <div class="chart-interactive-legend">
        <div class="chart-interactive-legend-item">
            <span class="chart-interactive-legend-icon">
                <svg viewBox="0 0 24 24">
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#f04438" stroke-width="3" />
                    <circle cx="12" cy="12" r="5" fill="#ffffff" stroke="#f04438" stroke-width="3" />
                </svg>
            </span>
            <span>Huyết áp tâm thu</span>
        </div>
        <div class="chart-interactive-legend-item">
            <span class="chart-interactive-legend-icon">
                <svg viewBox="0 0 24 24">
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#f79009" stroke-width="3" />
                    <circle cx="12" cy="12" r="5" fill="#ffffff" stroke="#f79009" stroke-width="3" />
                </svg>
            </span>
            <span>Huyết áp tâm trương</span>
        </div>
        <div class="chart-interactive-legend-item">
            <span class="chart-interactive-legend-icon">
                <svg viewBox="0 0 24 24">
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#12b76a" stroke-width="3" />
                    <circle cx="12" cy="12" r="5" fill="#ffffff" stroke="#12b76a" stroke-width="3" />
