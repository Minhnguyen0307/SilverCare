@using System.Collections.Generic
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Theo dõi sức khỏe";

    // Static Mock Resident health data
    var residents = new List<ResidentHealth>
    {
        new ResidentHealth { Id = "row-1", Initials = "NVA", Name = "Nguyễn Văn An", Room = "101", Systolic = 148, Diastolic = 96, HeartRate = 79, Temperature = 37.0, LastUpdated = "08:30 hôm nay" },
        new ResidentHealth { Id = "row-2", Initials = "TTB", Name = "Trần Thị Bảy", Room = "102", Systolic = 118, Diastolic = 75, HeartRate = 58, Temperature = 36.5, LastUpdated = "07:15 hôm nay" },
        new ResidentHealth { Id = "row-3", Initials = "LVC", Name = "Lê Văn Cường", Room = "103", Systolic = 125, Diastolic = 80, HeartRate = 70, Temperature = 37.2, LastUpdated = "06:45 hôm nay" },
        new ResidentHealth { Id = "row-4", Initials = "PHD", Name = "Phạm Hồng Dương", Room = "105", Systolic = 120, Diastolic = 78, HeartRate = 68, Temperature = 36.6, LastUpdated = "08:00 hôm nay" }
    };
}

@functions {
    public class ResidentHealth
    {
        public string Id { get; set; }
        public string Initials { get; set; }
        public string Name { get; set; }
        public string Room { get; set; }
        public int Systolic { get; set; }
        public int Diastolic { get; set; }
        public int HeartRate { get; set; }
        public double Temperature { get; set; }
        public string LastUpdated { get; set; }
    }

    public static (string Text, string Class) GetSeverity(int sys, int dia, int hr, double temp)
    {
        // 1. HIGH (Cao) Severity: one or more of these met
        if (sys >= 140 || 
            dia >= 90 || 
            (sys - dia) <= 20 || 
            hr > 100 || 
            hr < 50 || 
            temp >= 38.5 || 
            temp < 35.0)
        {
            return ("Cao", "severity-high");
        }

        // 2. MEDIUM (Trung bình) Severity: borderline readings
        if ((sys >= 120 && sys <= 139) || 
            (dia >= 80 && dia <= 89) || 
            (hr >= 91 && hr <= 100) || 
            (hr >= 50 && hr <= 59) || 
            (temp >= 37.5 && temp <= 38.4))
        {
            return ("Trung bình", "severity-medium");
        }

        // 3. NORMAL (Bình thường) Severity
        return ("Bình thường", "severity-normal");
    }
}

<div class="health-header">
    <h1 class="health-title">Theo dõi sức khỏe</h1>
    <p class="health-subtitle">Chỉ số sức khỏe hôm nay &middot; Cập nhật lần cuối: 09:15</p>
</div>

<!-- Filters Panel -->
<div class="health-filters-panel">
    <!-- Search -->
    <div class="health-search-wrapper">
        <svg viewBox="0 0 24 24" class="search-icon">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="text" class="health-search-input" placeholder="Tìm theo tên, phòng..." />
    </div>

    <!-- Filter Pills -->
    <div class="health-pills-wrapper">
        <button class="health-pill active">Tất cả</button>
        <button class="health-pill">Cao</button>
        <button class="health-pill">Trung bình</button>
        <button class="health-pill">Bình thường</button>
    </div>
</div>

<!-- Table Card -->
<div class="health-table-card">
    <div class="health-table-responsive">
        <table class="health-table">
            <thead>
                <tr>
                    <th>HỌ TÊN</th>
                    <th>PHÒNG</th>
                    <th>HUYẾT ÁP</th>
                    <th>NHỊP TIM</th>
                    <th>NHIỆT ĐỘ</th>
                    <th>CẬP NHẬT</th>
                    <th>MỨC ĐỘ</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in residents)
                {
                    var severity = GetSeverity(res.Systolic, res.Diastolic, res.HeartRate, res.Temperature);
                    <tr id="@res.Id" data-severity="@severity.Text" class="@(res.Id == "row-1" ? "selected-row" : "")">
                        <td>
                            <div class="table-profile-cell">
                                <div class="table-avatar text-blue">@res.Initials</div>
                                <span class="table-name">@res.Name</span>
                            </div>
                        </td>
                        <td>@res.Room</td>
                        <td class="cell-bp"><span class="bp-val">@res.Systolic/@res.Diastolic</span> mmHg</td>
                        <td class="cell-hr"><span class="hr-val">@res.HeartRate</span> lần/phút</td>
                        <td class="cell-temp"><span class="temp-val">@res.Temperature</span>&deg;C</td>
                        <td class="cell-time">@res.LastUpdated</td>
                        <td class="cell-severity">
                            <span class="severity-badge @severity.Class">@severity.Text</span>
                        </td>
                        <td>
                            <a href="#" class="table-action-link btn-update-trigger"
                               data-row-id="@res.Id"
                               data-name="@res.Name"
                               data-sys="@res.Systolic"
                               data-dia="@res.Diastolic"
                               data-hr="@res.HeartRate"
                               data-temp="@res.Temperature">
                                <!-- Pulse line SVG -->
                                <svg viewBox="0 0 24 24" class="pulse-icon">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                                </svg>
                                <span>Cập nhật</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ==========================================================================
   INTERACTIVE PATIENT CHART CARD
   ========================================================================== -->
