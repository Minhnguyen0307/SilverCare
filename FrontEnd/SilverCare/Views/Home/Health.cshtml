@using System.Collections.Generic
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Theo dõi sức khỏe";

    // Static Mock Resident health data matching image 2
    var residents = new List<ResidentHealth>
    {
        new ResidentHealth { Id = "row-1", Initials = "NVA", Name = "Nguyễn Văn An", Room = "201", Systolic = 132, Diastolic = 85, HeartRate = 74, Temperature = 36.8, LastUpdated = "11:03 hôm nay" },
        new ResidentHealth { Id = "row-2", Initials = "LVB", Name = "Lê Văn Bình", Room = "102", Systolic = 124, Diastolic = 73, HeartRate = 68, Temperature = 37.2, LastUpdated = "14:43 hôm nay" },
        new ResidentHealth { Id = "row-3", Initials = "PTC", Name = "Phạm Thị Cúc", Room = "305", Systolic = 105, Diastolic = 65, HeartRate = 83, Temperature = 37.6, LastUpdated = "14:43 hôm nay" }
    };

    // Capture logged-in user profile name
    var fullName = TempData["FullName"] as string ?? "Nguyễn Thị Lan";
    TempData.Keep("FullName");
}

@functions {
    public class ResidentHealth
    {
        public string Id { get; set; }
        public string Initials { get; set; }
        public string Name { get; set; }
        public string Room { get; set; }
        public int Systolic { get; set; }
        public int Diastolic { get; set; }
        public int HeartRate { get; set; }
        public double Temperature { get; set; }
        public string LastUpdated { get; set; }
    }

    public static (string Text, string Class) GetSeverity(int sys, int dia, int hr, double temp)
    {
        // 1. HIGH (Cao) Severity: one or more of these met
        if (sys >= 140 || 
            dia >= 90 || 
            (sys - dia) <= 20 || 
            hr > 100 || 
            hr < 50 || 
            temp >= 38.5 || 
            temp < 35.0)
        {
            return ("Cao", "severity-high");
        }

        // 2. MEDIUM (Trung bình) Severity: borderline readings
        if ((sys >= 120 && sys <= 139) || 
            (dia >= 80 && dia <= 89) || 
            (hr >= 91 && hr <= 100) || 
            (hr >= 50 && hr <= 59) || 
            (temp >= 37.5 && temp <= 38.4))
        {
            return ("Trung bình", "severity-medium");
        }

        // 3. NORMAL (Bình thường) Severity
        return ("Bình thường", "severity-normal");
    }
}

<style>
    @@keyframes chartPulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(11, 165, 236, 0.6); border-color: #0ba5ec; }
        50% { box-shadow: 0 0 0 10px rgba(11, 165, 236, 0.2); border-color: #0ba5ec; }
        100% { box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05); border-color: var(--border-color); }
